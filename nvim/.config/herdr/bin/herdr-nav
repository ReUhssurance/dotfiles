#!/bin/sh
# vim-aware direct pane navigation for herdr.
#
# Mirrors the is_vim guard in tmux/.tmux.conf: when the focused pane is running
# vim or neovim the key is forwarded to the editor so it moves between the
# editor's own splits, otherwise herdr moves pane focus. Bound to bare
# ctrl+hjkl in config.toml, so it runs on every press — kept to sh and jq
# because python3 startup alone costs ~270ms here.
#
# Nothing here may depend on the environment. herdr spawns keybinding commands
# with an environment we do not control: $HOME and $PATH may both be absent,
# which previously made this exit before it could even log. Every binary and
# path below is derived from this script's own location. Create herdr-nav.debug beside config.toml to trace.

# Locate everything relative to this script rather than hardcoding a home
# directory, so the same file works on Linux and macOS. cd and pwd are shell
# builtins, so this needs neither PATH nor HOME. pwd keeps the symlinked
# ~/.config/herdr path, which is where herdr.sock lives.
CONFIG_DIR=$(cd "${0%/*}/.." && pwd)
HOME_DIR=$(cd "$CONFIG_DIR/../.." && pwd)

find_bin() {
  for d in "$HOME_DIR/.local/bin" /opt/homebrew/bin /usr/local/bin /usr/bin /bin; do
    [ -x "$d/$1" ] && { echo "$d/$1"; return; }
  done
}
HERDR=$(find_bin herdr)
JQ=$(find_bin jq)
LOG=$CONFIG_DIR/herdr-nav.log

# Without HOME the herdr CLI resolves its socket under TMPDIR and reports
# server_not_running, so point it at the real one rather than trusting the
# inherited environment.
HERDR_SOCKET_PATH=${HERDR_SOCKET_PATH:-$CONFIG_DIR/herdr.sock}
export HERDR_SOCKET_PATH

debug() {
  [ -e "$CONFIG_DIR/herdr-nav.debug" ] || return 0
  printf '%s %s\n' "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$LOG" 2>/dev/null
}

debug "=== invoked argv=$* home=${HOME-UNSET} path=${PATH-UNSET}"

case "$1" in
  h) direction=left;  key=ctrl+h ;;
  j) direction=down;  key=ctrl+j ;;
  k) direction=up;    key=ctrl+k ;;
  l) direction=right; key=ctrl+l ;;
  *) echo "usage: herdr-nav <h|j|k|l>" >&2; exit 64 ;;
esac

[ -x "$HERDR" ] || { debug "FATAL missing $HERDR"; exit 127; }
[ -x "$JQ" ] || { debug "FATAL missing $JQ"; exit 127; }

raw=$("$HERDR" pane process-info --current 2>&1) || {
  debug "FATAL process-info failed: $raw"
  exit 1
}

# Same editor pattern as tmux/.tmux.conf, matched against every process in the
# pane's foreground group: shells report helpers alongside the real command.
info=$(printf '%s' "$raw" | "$JQ" -r '
  .result.process_info
  | [ .pane_id,
      ( (.foreground_processes // [])
        | map(.argv0 // .name // "")
        | any(test("^g?(view|n?vim?)(diff)?$"))
        | tostring )
    ]
  | @tsv' 2>&1) || {
  debug "FATAL jq failed: $info"
  exit 1
}

pane=${info%%	*}
is_vim=${info##*	}

if [ -z "$pane" ] || [ "$pane" = null ]; then
  debug "FATAL no current pane; raw=$raw"
  exit 1
fi

if [ "$is_vim" = true ]; then
  debug "pane=$pane vim=yes -> send-keys $key"
  out=$("$HERDR" pane send-keys "$pane" "$key" 2>&1) || debug "send-keys failed: $out"
else
  debug "pane=$pane vim=no -> focus $direction"
  out=$("$HERDR" pane focus --direction "$direction" --current 2>&1) || debug "focus failed: $out"
fi
debug "done"
